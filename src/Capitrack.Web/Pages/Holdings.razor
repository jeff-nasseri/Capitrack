@page "/holdings"
@inject ApiClient Api
@inject AppState State
@inject TopBarState TopBar

<div class="page page-wide">
    @if (_loading)
    {
        <div class="loading-spinner">Loading holdings…</div>
    }
    else
    {
        <div class="grid" style="grid-template-columns:repeat(3, 1fr);margin-bottom:18px;">
            <StatCard Label="Holdings value" Value="@Format.Money(_totVal, _base)" />
            <StatCard Label="Total gain / loss" Value="@Format.Signed(_totGain, _base)" Delta="@Format.Pct(_gp)" DeltaUp="@(_totGain >= 0)" />
            <StatCard Label="Positions" Value="@_holdings.Count.ToString()" Delta="@($"{_winners} in profit")" DeltaUp="true" />
        </div>

        <div class="row-between" style="margin-bottom:12px;">
            <span class="section-title">All positions</span>
            <div class="flex gap-2">
                <div style="position:relative;">
                    <span style="position:absolute;left:11px;top:50%;transform:translateY(-50%);color:var(--text-4);"><Icon Name="search" Width="16" Height="16" /></span>
                    <input class="input btn-sm" style="height:36px;width:220px;padding-left:34px;" placeholder="Search positions" value="@_query" @oninput="OnSearch" />
                </div>
                <button class="btn-icon" title="Filter"><Icon Name="filter" /></button>
            </div>
        </div>

        <HoldingsTable Holdings="_filtered" />
    }
</div>

@code {
    private List<EnrichedHolding> _holdings = [];
    private List<EnrichedHolding> _filtered = [];
    private bool _loading = true;
    private string _query = "";
    private string _base = "USD";
    private double _totVal, _totGain, _gp;
    private int _winners;

    protected override async Task OnInitializedAsync()
    {
        TopBar.Set("Holdings");

        var accounts = await Api.GetAsync<List<AccountDto>>("/api/accounts") ?? [];
        State.Accounts = accounts;

        var all = new List<EnrichedHolding>();
        foreach (var a in accounts)
        {
            var hs = await Api.GetAsync<List<HoldingDto>>($"/api/accounts/{a.Id}/holdings") ?? [];
            foreach (var h in hs)
                all.Add(new EnrichedHolding
                {
                    Symbol = h.Symbol, Quantity = h.Quantity, AvgCost = h.AvgCost, TotalCost = h.TotalCost,
                    TransactionCount = h.TransactionCount, AccountId = a.Id, AccountCurrency = a.Currency
                });
        }

        var symbols = all.Select(h => h.Symbol).Distinct().ToList();
        var prices = symbols.Count > 0
            ? await Api.PostAsync<Dictionary<string, QuoteDto>>("/api/prices/quotes", new { symbols }) ?? []
            : [];

        foreach (var h in all)
        {
            var p = prices.GetValueOrDefault(h.Symbol);
            var price = p?.Price ?? 0;
            var mv = h.Quantity * price;
            var cb = h.Quantity * (h.AvgCost ?? 0);
            h.Price = price; h.Name = p?.Name ?? h.Symbol; h.ChangePercent = p?.ChangePercent ?? 0;
            h.MarketValue = mv; h.CostBasis = cb; h.Gain = mv - cb;
            h.GainPct = cb > 0 ? (mv - cb) / cb * 100 : 0; h.Currency = p?.Currency ?? "USD";
        }

        _holdings = all.OrderByDescending(h => h.MarketValue).ToList();
        State.AllHoldings = _holdings;

        _base = _holdings.FirstOrDefault()?.Currency ?? "USD";
        _totVal = _holdings.Sum(h => h.MarketValue);
        _totGain = _holdings.Sum(h => h.Gain);
        var cost = _totVal - _totGain;
        _gp = cost > 0 ? _totGain / cost * 100 : 0;
        _winners = _holdings.Count(h => h.Gain >= 0);

        ApplyFilter();
        _loading = false;
    }

    private void OnSearch(ChangeEventArgs e)
    {
        _query = e.Value?.ToString() ?? "";
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        if (string.IsNullOrWhiteSpace(_query))
        {
            _filtered = _holdings;
            return;
        }
        var q = _query.Trim();
        _filtered = _holdings.Where(h =>
            (h.Symbol?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (h.Name?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)).ToList();
    }
}

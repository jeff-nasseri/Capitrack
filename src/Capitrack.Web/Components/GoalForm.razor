<form @onsubmit="Save" @onsubmit:preventDefault>
    <div class="field"><label>Title</label><input class="input" type="text" @bind="Model.Title" required /></div>
    <div class="form-row">
        <div class="field"><label>Target Amount</label><input class="input" type="number" step="any" min="0" @bind="Model.TargetAmount" required /></div>
        <div class="field"><label>Target Date</label><input class="input" type="date" value="@Model.TargetDate" @onchange="e => Model.TargetDate = e.Value?.ToString() ?? string.Empty" required /></div>
    </div>
    @if (Tags.Count > 0)
    {
        <div class="field">
            <label>Tags</label>
            <div class="tag-checkboxes">
                @foreach (var t in Tags)
                {
                    <label class="tag-checkbox">
                        <input type="checkbox" checked="@Model.TagIds.Contains(t.Id)"
                               @onchange="e => ToggleTag(t.Id, (bool)(e.Value ?? false))" />
                        <span>@t.Name</span>
                    </label>
                }
            </div>
        </div>
    }
    <div class="field"><label>Description</label><textarea class="input" rows="2" @bind="Model.Description"></textarea></div>
    @if (Model.Id is not null)
    {
        <div class="field">
            <label style="display:flex;align-items:center;gap:0.5rem;cursor:pointer;text-transform:none;letter-spacing:0;font-size:0.85rem;">
                <input type="checkbox" @bind="Model.Achieved" style="width:auto;accent-color:var(--pri);" /> Mark as achieved
            </label>
        </div>
    }
    <button type="submit" class="btn btn-pri btn-block"><Icon Name="check" /> Save</button>
</form>

@code {
    [Parameter] public GoalFormModel Model { get; set; } = new();
    [Parameter] public IReadOnlyList<TagDto> Tags { get; set; } = [];
    [Parameter] public EventCallback OnSave { get; set; }

    private void ToggleTag(int id, bool on) { if (on) Model.TagIds.Add(id); else Model.TagIds.Remove(id); }
    private async Task Save() => await OnSave.InvokeAsync();
}

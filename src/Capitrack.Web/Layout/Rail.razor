@implements IDisposable
@inject NavigationManager Nav
@inject ApiClient Api
@inject AppState State
@inject IJSRuntime JS

<nav class="rail @(_open ? "open" : "")">
    <a class="rail-brand" href="" @onclick:preventDefault @onclick='() => Go("")'>
        <Logo Size="34" />
        <span class="logo-text"><b>Capi</b>track</span>
    </a>

    <div class="rail-nav">
        @if (_open)
        {
            <div class="rail-sec">Menu</div>
        }
        @foreach (var n in Items)
        {
            <button class="nav-item @(IsActive(n.Id) ? "active" : "")" @onclick="() => Go(n.Route)" title="@n.Label">
                <Icon Name="@n.Icon" />
                <span class="nav-label">@n.Label</span>
            </button>
        }
    </div>

    <div class="rail-bottom">
        <button class="nav-item" @onclick="Toggle" title="@(_open ? "Collapse" : "Expand")">
            <span style="display:inline-flex;transform:@(_open ? "rotate(180deg)" : "none");transition:transform var(--tr);"><Icon Name="chevR" /></span>
            <span class="nav-label">Collapse</span>
        </button>
        <button class="nav-item @(IsActive("settings") ? "active" : "")" @onclick='() => Go("settings")' title="Settings">
            <Icon Name="settings" /><span class="nav-label">Settings</span>
        </button>
        <button class="nav-item" @onclick="Logout" title="Log out">
            <Icon Name="logout" /><span class="nav-label">Log out</span>
        </button>
    </div>
</nav>

@code {
    private record NavDef(string Id, string Route, string Icon, string Label);
    private static readonly NavDef[] Items =
    [
        new("dashboard", "", "dashboard", "Dashboard"),
        new("holdings", "holdings", "holdings", "Holdings"),
        new("accounts", "accounts", "accounts", "Accounts"),
        new("activity", "activity", "activity", "Activity"),
        new("goals", "goals", "goals", "Goals"),
        new("calendar", "calendar", "calendar", "Calendar"),
    ];

    private bool _open;

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        var v = await JS.InvokeAsync<string?>("capitrack.getLocal", "wealth-sidebar-expanded");
        _open = v == "1";
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => InvokeAsync(StateHasChanged);

    private string[] Segs()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].Trim('/');
        return path.Length == 0 ? [] : path.Split('/');
    }

    private bool IsActive(string id)
    {
        var s = Segs();
        return id switch
        {
            "dashboard" => s.Length == 0,
            "holdings" => s.Length > 0 && (s[0] == "holdings" || (s[0] == "accounts" && s.Length == 3)),
            "accounts" => s.Length > 0 && s[0] == "accounts" && s.Length <= 2,
            _ => s.Length > 0 && s[0] == id
        };
    }

    private void Go(string route) => Nav.NavigateTo("/" + route);

    private async Task Toggle()
    {
        _open = !_open;
        await JS.InvokeVoidAsync("capitrack.setLocal", "wealth-sidebar-expanded", _open ? "1" : "0");
    }

    private async Task Logout()
    {
        await Api.PostAsync<object>("/api/auth/logout", new { });
        State.User = null;
        State.NotifyChanged();
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Client.Application</RootNamespace>
    <!-- Fluxor 6.6.0's DI.Abstractions upper-bound (<10) is intentionally overridden to 10.0.0. -->
    <NoWarn>$(NoWarn);NU1608</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Fluxor" Version="6.6.0" />
    <!-- Fluxor 6.6.0 pins DI.Abstractions to <10; pin 10.0.0 to align with the net10 stack. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <!-- IJSRuntime for the Theme effects (capitrack.getTheme / setTheme). -->
    <PackageReference Include="Microsoft.JSInterop" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Client.Domain\Client.Domain.csproj" />
  </ItemGroup>

</Project>

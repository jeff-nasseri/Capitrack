@using System.Text.Json
@inherits FluxorComponent
@inject ApiClient Api
@inject IDispatcher Dispatcher
@inject IState<ThemeState> ThemeState

<div style="height:100vh;display:grid;place-items:center;padding:24px;position:relative;overflow:hidden;">
    <div class="app-bg"></div>
    <button class="btn-icon" @onclick="ToggleTheme" style="position:fixed;top:22px;right:22px;z-index:5;" title="Toggle theme">
        <Icon Name="@(ThemeState.Value.Theme == "dark" ? "sun" : "moon")" />
    </button>

    <div class="card login-card" style="position:relative;z-index:2;width:min(880px,100%);display:grid;grid-template-columns:1.05fr 1fr;overflow:hidden;box-shadow:var(--shadow-lg);">
        <div class="login-brand" style="padding:40px 38px;background:linear-gradient(160deg, var(--pri), #4f46e5 90%);color:#fff;position:relative;overflow:hidden;">
            <div style="position:absolute;inset:0;opacity:0.16;background-image:radial-gradient(circle at 80% 10%, #fff, transparent 45%);"></div>
            <div style="position:relative;">
                <div class="flex gap-3">
                    <div style="background:rgba(255,255,255,0.16);border-radius:12px;padding:5px;backdrop-filter:blur(4px);"><Logo Size="34" /></div>
                    <span style="font-weight:700;font-size:1.25rem;letter-spacing:-0.02em;"><b style="font-weight:800;">Capi</b>track</span>
                </div>
                <h2 style="font-size:1.7rem;font-weight:800;letter-spacing:-0.03em;line-height:1.15;margin-top:38px;">Track your wealth.<br />Own your data.</h2>
                <p style="opacity:0.82;font-size:0.92rem;margin-top:12px;line-height:1.6;">Your private dashboard for stocks, crypto and commodities — self-hosted on your own server.</p>
                <div style="margin-top:38px;display:flex;flex-direction:column;gap:14px;">
                    @foreach (var (ic, t) in Bullets)
                    {
                        <div class="flex gap-3" style="font-size:0.9rem;font-weight:500;">
                            <span style="display:grid;place-items:center;width:30px;height:30px;border-radius:8px;background:rgba(255,255,255,0.16);"><Icon Name="@ic" Width="16" Height="16" /></span>
                            @t
                        </div>
                    }
                </div>
            </div>
        </div>

        <div style="padding:46px 40px;display:flex;flex-direction:column;justify-content:center;">
            <h1 style="font-size:1.5rem;font-weight:800;letter-spacing:-0.02em;">Welcome back</h1>
            <p class="sub" style="margin-top:4px;">Sign in to your Capitrack instance</p>
            <form @onsubmit="DoLogin" @onsubmit:preventDefault style="margin-top:26px;display:flex;flex-direction:column;gap:16px;">
                <div class="field">
                    <label>Username</label>
                    <div style="position:relative;">
                        <span style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--text-4);"><Icon Name="user" Width="17" Height="17" /></span>
                        <input class="input" style="padding-left:38px;" @bind="_username" @bind:event="oninput" placeholder="Enter username" autocomplete="username" />
                    </div>
                </div>
                <div class="field">
                    <label>Password</label>
                    <div style="position:relative;">
                        <span style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--text-4);"><Icon Name="lock" Width="17" Height="17" /></span>
                        <input class="input" style="padding-left:38px;" type="password" @bind="_password" @bind:event="oninput" placeholder="Enter password" autocomplete="current-password" />
                    </div>
                </div>
                <button class="btn btn-pri" type="submit" style="height:44px;margin-top:4px;">
                    <Icon Name="logout" Style="transform:scaleX(-1);" /> Sign In
                </button>
                @if (_error is not null)
                {
                    <div class="error-message">@_error</div>
                }
            </form>
            <div style="margin-top:20px;padding:10px 12px;border-radius:var(--r-sm);background:var(--surface-2);border:1px solid var(--border);font-size:0.8rem;color:var(--text-3);display:flex;gap:8px;align-items:center;">
                <Icon Name="info" Width="15" Height="15" /> <span>First run? The admin password is printed in the server logs (<code>docker compose logs api</code>).</span>
            </div>
        </div>
    </div>
</div>

@code {
    private static readonly (string, string)[] Bullets =
    [
        ("holdings", "Real-time portfolio valuation"),
        ("shield", "Zero telemetry, fully private"),
        ("goals", "Goals tracked to your target date"),
    ];

    private string _username = "admin";
    private string _password = "";
    private string? _error;

    private async Task DoLogin()
    {
        _error = null;
        try
        {
            var (ok, json) = await Api.PostWithStatusAsync<JsonElement>("/api/auth/login",
                new { username = _username, password = _password });
            if (ok)
            {
                Dispatcher.Dispatch(new SetUserAction(new SessionDto
                {
                    Username = json.GetProperty("username").GetString() ?? "",
                    BaseCurrency = json.TryGetProperty("base_currency", out var bc) ? bc.GetString() ?? "EUR" : "EUR"
                }));
            }
            else
            {
                _error = json.TryGetProperty("error", out var e) ? e.GetString() : "Login failed";
            }
        }
        catch
        {
            _error = "Connection error";
        }
    }

    private void ToggleTheme() => Dispatcher.Dispatch(new ToggleThemeAction());
}

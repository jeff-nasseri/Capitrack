@page "/goals"
@inject ApiClient Api
@inject TopBarState TopBar
@inject ModalService Modal
@inject ToastService Toast

<div class="page page-wide">
    @if (_loading)
    {
        <div class="loading-spinner">Loading goals…</div>
    }
    else if (_goals.Count == 0)
    {
        <div class="card card-pad">
            <div class="empty-state"><Icon Name="goals" /><p>No goals set. Click “Add goal” to create one.</p></div>
        </div>
    }
    else
    {
        var overall = (int)Math.Round(_goals.Average(Progress));

        @* year progress *@
        <div class="card card-pad" style="background:linear-gradient(120deg, var(--pri-soft), transparent 60%), var(--surface);">
            <div class="row-between">
                <div>
                    <div class="eyebrow">@DateTime.Now.Year progress</div>
                    <div class="bignum" style="font-size:1.8rem;margin-top:6px;">@overall% <span class="sub" style="font-size:0.9rem;font-weight:500;">across @_goals.Count goal@(_goals.Count != 1 ? "s" : "")</span></div>
                </div>
                <Ring Pct="overall" Size="76" Sw="8" />
            </div>
            <div class="bar mt-4" style="height:9px;"><i style="width:@overall%;"></i></div>
        </div>

        @* goal cards *@
        <div class="grid mt-4" style="grid-template-columns:repeat(2, 1fr);">
            @foreach (var g in _goals)
            {
                var progress = Progress(g);
                var tagColor = g.Tags.Count > 0 ? g.Tags[0].Color : "var(--pri-2)";
                <div class="card card-pad card-hover" @onclick="() => ShowGoal(g)">
                    <div class="flex gap-4">
                        <Ring Pct="progress" Size="70" Sw="8" Color="@tagColor" />
                        <div style="flex:1;min-width:0;">
                            <div class="row-between">
                                <div class="flex gap-2" style="min-width:0;">
                                    <Icon Name="goals" Width="17" Height="17" Style="@($"color:{tagColor};flex-shrink:0;")" />
                                    <b style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@g.Title</b>
                                </div>
                                @if (g.Tags.Count > 0)
                                {
                                    <span class="chip" style="@($"color:{g.Tags[0].Color};background:color-mix(in srgb,{g.Tags[0].Color} 14%, transparent);")">@g.Tags[0].Name</span>
                                }
                            </div>
                            <div class="tnum mt-2" style="font-weight:750;font-size:1.15rem;">@Format.Money(_wealth, _base, 0) <span class="sub" style="font-weight:500;">/ @Format.Money(g.TargetAmount, _base, 0)</span></div>
                            <div class="bar mt-2"><i style="@BarFill(g, progress)"></i></div>
                            <div class="flex row-between mt-2">
                                <span class="sub flex gap-2"><Icon Name="calendar" Width="13" Height="13" /> @Format.Date(g.TargetDate)</span>
                                <span class="sub tnum">@Format.Money(Math.Max(0, g.TargetAmount - _wealth), _base, 0) to go</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
            <button class="card card-pad" style="display:grid;place-items:center;min-height:150px;border:1.5px dashed var(--border-2);background:transparent;cursor:pointer;color:var(--text-3);" @onclick="() => ShowGoal(null)">
                <div class="flex-col gap-2" style="align-items:center;">
                    <div class="btn-icon" style="width:44px;height:44px;border-radius:13px;"><Icon Name="plus" /></div>
                    <span style="font-weight:600;font-size:0.9rem;">Add goal</span>
                </div>
            </button>
        </div>
    }
</div>

@code {
    private List<GoalDto> _goals = [];
    private List<TagDto> _tags = [];
    private double _wealth;
    private string _base = "EUR";
    private bool _loading = true;

    private RenderFragment Actions => @<button class="btn btn-pri btn-sm" @onclick="() => ShowGoal(null)"><Icon Name="plus" /> Add goal</button>;

    protected override async Task OnInitializedAsync()
    {
        TopBar.Set("Financial Goals", Actions);
        await Load();
    }

    private async Task Load()
    {
        var goalsTask = Api.GetAsync<List<GoalDto>>("/api/goals");
        var summaryTask = Api.GetAsync<DashboardSummaryDto>("/api/prices/dashboard/summary");
        await Task.WhenAll(goalsTask, summaryTask);
        _goals = await goalsTask ?? [];
        var summary = await summaryTask;
        _wealth = summary?.TotalWealth ?? 0;
        _base = summary?.BaseCurrency ?? "EUR";
        _loading = false;
    }

    private double Progress(GoalDto g) => g.TargetAmount > 0 ? Math.Min(100, _wealth / g.TargetAmount * 100) : 0;

    // When the goal has a tag colour, tint the bar with a shade→colour gradient; otherwise keep the default .bar gradient.
    private static string BarFill(GoalDto g, double progress)
    {
        var width = $"width:{progress.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%;";
        if (g.Tags.Count == 0) return width;
        var c = g.Tags[0].Color;
        return $"{width}background:linear-gradient(90deg, {Coins.Shade(c, -10)}, {c});";
    }

    private async Task ShowGoal(GoalDto? g)
    {
        _tags = await Api.GetAsync<List<TagDto>>("/api/tags") ?? [];
        var model = new GoalFormModel
        {
            Id = g?.Id, Title = g?.Title ?? "", TargetAmount = g?.TargetAmount,
            TargetDate = g?.TargetDate.Split('T')[0] ?? "", Description = g?.Description ?? "",
            Achieved = g?.Achieved != 0 && g is not null, TagIds = g?.Tags.Select(t => t.Id).ToHashSet() ?? []
        };
        Modal.Show(g is null ? "Add Goal" : "Edit Goal", @<GoalForm Model="model" Tags="_tags" OnSave="() => SaveGoal(model)" />);
    }

    private async Task SaveGoal(GoalFormModel m)
    {
        var body = new
        {
            title = m.Title, target_amount = m.TargetAmount ?? 0, target_date = m.TargetDate,
            description = m.Description, achieved = m.Achieved, tag_ids = m.TagIds.ToList()
        };
        if (m.Id is int id) await Api.PutAsync<GoalDto>($"/api/goals/{id}", body);
        else await Api.PostAsync<GoalDto>("/api/goals", body);
        Modal.Close();
        Toast.Show(m.Id is null ? "Goal created" : "Goal updated", "success");
        await Load();
    }
}

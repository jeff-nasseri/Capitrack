# Copy this file to ".env" (which is gitignored) to configure the first-run admin
# account and base currency. These are read by the "api" service in docker-compose.yml.
#
# All values are optional. They only take effect on the FIRST run, while the
# database is empty.

# Admin username (not a secret).
CAPITRACK_INIT_USERNAME=admin

# Admin password. Leave EMPTY to have a strong random password generated on first
# run and printed to the container logs:  docker compose logs api
CAPITRACK_INIT_PASSWORD=

# Base currency used for dashboard totals.
CAPITRACK_BASE_CURRENCY=EUR

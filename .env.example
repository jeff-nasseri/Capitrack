# Copy this file to ".env" (which is gitignored) to configure the first-run admin
# account, base currency and optional market-data API keys. These are read by the "api" service in docker-compose.yml.
#
# All values are optional. They only take effect on the FIRST run, while the
# database is empty.

# Admin username (not a secret).
CAPITRACK_INIT_USERNAME=admin

# Admin password. Leave EMPTY to have a strong random password generated on first
# run and printed to the container logs:  docker compose logs api
CAPITRACK_INIT_PASSWORD=

# Base currency used for dashboard totals.
CAPITRACK_BASE_CURRENCY=EUR

# ---- Market data (optional) ----
# Prices come from free providers; the order per asset class is set in Settings > Market Data.
# Kraken, Bitvavo, CoinGecko (keyless), the ECB and Yahoo Finance need no key.

# CoinGecko Demo key: optional, raises the rate limit (~30 calls/min, 10,000/month).
# Free at https://www.coingecko.com/en/developers/dashboard
COINGECKO_DEMO_API_KEY=

# Twelve Data key: needed to use Twelve Data (US stocks/ETFs, forex, crypto; 800 credits/day, 8/min).
# Free at https://twelvedata.com/account/api-keys
TWELVE_DATA_API_KEY=

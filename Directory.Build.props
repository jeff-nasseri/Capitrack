<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Authors>Jeff Nasseri</Authors>
    <Company>Capitrack</Company>
  </PropertyGroup>

  <ItemGroup>
    <!--
      CVE-2026-32933 / GHSA-rvv3-g6hj-g44x: AutoMapper < 15.1.1 can be crashed by a
      ~25,000-level deep self-referential object graph (uncontrolled recursion -> stack
      overflow, DoS). This vector is NOT reachable in Capitrack: every AutoMapper profile
      maps a flat domain entity/value object onto a flat DTO — there is no recursive,
      attacker-controlled object graph anywhere in the mapping configuration.
      The only patched releases (15.1.1+ / 16.1.1+) ship under the copyleft RPL-1.5 +
      commercial dual license, which is incompatible with this MIT-licensed project, so we
      deliberately stay on the permissively-licensed (MIT/Apache-2.0) AutoMapper 12.0.1 and
      suppress this single advisory after the assessment above.
    -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-rvv3-g6hj-g44x" />
  </ItemGroup>
</Project>
